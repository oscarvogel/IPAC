DJANGO_SECRET_KEY=generate-a-long-random-production-secret
DJANGO_DEBUG=0
IPAC_ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://ipac:replace-this-database-password@db:5432/ipac
POSTGRES_DB=ipac
POSTGRES_USER=ipac
POSTGRES_PASSWORD=replace-this-database-password
IPAC_RUN_SEED=0
IPAC_SEED_ADMIN_USERNAME=
IPAC_SEED_ADMIN_PASSWORD=
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

IPAC_AI_ENABLED=0
IPAC_AI_PROVIDER=minimax
IPAC_AI_API_KEY=
IPAC_AI_MODEL=MiniMax-M3
IPAC_AI_BASE_URL=https://api.minimax.io/v1/chat/completions
IPAC_AI_TIMEOUT_SECONDS=30

# Notificaciones del Asistente IPAC
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=IPAC <no-reply@localhost>
